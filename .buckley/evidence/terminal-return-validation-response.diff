+func TestBuildRejectsStatementAfterReturn(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		want string
+		line int
+		col  int
+	}{
+		{
+			name: "trailing let",
+			src: `pipeline pass(x: f16[N]) -> f16[N] {
+    return x
+    let unreachable = normalize(x)
+}`,
+			want: "unreachable",
+			line: 3,
+			col:  5,
+		},
+		{
+			name: "trailing second return",
+			src: `pipeline pass(x: f16[N]) -> f16[N] {
+    return x
+    return x
+}`,
+			want: "unreachable",
+			line: 3,
+			col:  5,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := Build([]byte(tc.src), Options{ModuleName: tc.name})
+			if err == nil {
+				t.Fatal("expected diagnostic error")
+			}
+			msg := err.Error()
+			if !strings.Contains(msg, tc.want) {
+				t.Fatalf("unexpected diagnostic:\n%v", err)
+			}
+			if !strings.Contains(msg, fmt.Sprintf("%d:%d", tc.line, tc.col)) {
+				t.Fatalf("diagnostic not source-tied at %d:%d:\n%v", tc.line, tc.col, err)
+			}
+		})
+	}
+}