diff --git a/compiler/compiler_test.go b/compiler/compiler_test.go
--- a/compiler/compiler_test.go
+++ b/compiler/compiler_test.go
@@ -0,0 +1,30 @@
+
+func TestBuildUnreachableAfterReturn(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		want string
+	}{
+		{
+			name: "statement after return",
+			src: `func f() -> i32 {
+	let x: i32 = 1
+	return x
+	let y: i32 = 2
+}
+`,
+			want: "error:4:2: unreachable statement after return",
+		},
+		{
+			name: "second return after return",
+			src: `func f() -> i32 {
+	return 1
+	return 2
+}
+`,
+			want: "error:3:2: unreachable statement after return",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := Build(tt.src)
+			if err == nil || !strings.Contains(err.Error(), tt.want) {
+				t.Fatalf("Build() error = %v, want containing %q", err, tt.want)
+			}
+		})
+	}
+}