+func TestValidateRejectsDuplicateEntrypointNames(t *testing.T) {
+	module := NewModule("duplicate-entry")
+	module.EntryPoints = []EntryPoint{
+		{
+			Name: "embed",
+			Kind: EntryPointPipeline,
+		},
+		{
+			Name: "embed",
+			Kind: EntryPointPipeline,
+		},
+	}
+
+	err := module.Validate()
